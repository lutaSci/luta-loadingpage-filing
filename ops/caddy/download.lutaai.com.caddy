# Desired production site block for the shared Caddy gateway.
#
# Immutable Android release paths are content-addressed in luta-public. Legacy
# and unrelated paths stay on luta-app so this route does not silently migrate
# the rest of the historical download namespace.
download.lutaai.com {
	encode gzip zstd

	# Reduce bot noise without retaining the user-agent itself.
	map {header.User-Agent} {known_bot} {
		~(?i)(bot|spider|crawler|headless|preview|fetcher) true
		default false
	}

	# Only qualified tokenized APK requests enter this privacy-minimized log.
	# The host must persist /var/log/caddy outside the container. Status, size
	# and duration are Caddy standard fields; request identity is discarded.
	log apk_delivery {
		no_hostname
		output file {$APK_DELIVERY_LOG_PATH:/var/log/caddy/apk-delivery.json} {
			# Production is pinned to Caddy 2.8.4. Its file writer does not
			# support a mode subdirective and creates private 0600 files. The
			# host directory must remain root-owned 0700 until a separately
			# approved read-only reporting broker is deployed.
			roll_size 50mb
			roll_at 00:00
			# In Caddy 2.8.4, zero is replaced by the default count cap of 10.
			# A negative count reaches lumberjack as "no count cap", leaving
			# the 35-day age policy authoritative. Disk use must be monitored.
			roll_keep -1
			roll_keep_for 840h
			# The root-owned projection reader tracks rotated files by inode and
			# byte offset. Keep rotations as JSONL instead of gzip so offsets are
			# replayable without copying the private source log elsewhere.
			roll_uncompressed
		}
		format filter {
			wrap json
			request delete
			resp_headers delete
			# Caddy 2.8.4 emits an empty standard user_id field even though this
			# public route has no account identity. Remove the field at source so
			# the private delivery log contains only the approved technical facts.
			user_id delete
			status rename http_status
			size rename bytes_written
			bytes_read delete
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	}

	@private_android_rollback path /releases/android/china/_rollback/*
	handle @private_android_rollback {
		# The named access logger is site-scoped in Caddy 2.8.4. Explicitly
		# suppress every non-qualified route so ordinary download traffic never
		# enters the delivery reader's source file.
		log_skip
		respond 404
	}

	@qualified_apk_delivery path_regexp qualified_apk_delivery ^/dl/(?P<traffic_purpose>production|qa|smoke|internal|development)/(?P<download_id>dl_[0-9a-f]{32})/(?P<artifact_size_bytes>[1-9][0-9]*)/releases/android/china/(?P<app_version>[0-9]+(?:\.[0-9]+){2})(?:%2[Bb]|\+)(?P<build_number>[1-9][0-9]*)/(?P<artifact_id>[0-9a-f]{64})\.apk$
	handle @qualified_apk_delivery {
		log_name apk_delivery
		# Caddy 2.8.4 treats a leading "<" as part of the JSON key. Use the
		# version-compatible form verified against the production image.
		log_append request_method {http.request.method}
		log_append traffic_purpose {re.qualified_apk_delivery.traffic_purpose}
		log_append download_id {re.qualified_apk_delivery.download_id}
		log_append artifact_id {re.qualified_apk_delivery.artifact_id}
		log_append artifact_size_bytes {re.qualified_apk_delivery.artifact_size_bytes}
		log_append app_version {re.qualified_apk_delivery.app_version}
		log_append build_number {re.qualified_apk_delivery.build_number}
		log_append known_bot {known_bot}
		# Prefix stripping preserves the raw %2B in the immutable object path;
		# rewriting from a regexp capture decodes it to '+' and makes OSS 404.
		uri strip_prefix /dl/{re.qualified_apk_delivery.traffic_purpose}/{re.qualified_apk_delivery.download_id}/{re.qualified_apk_delivery.artifact_size_bytes}
		reverse_proxy https://luta-public.oss-cn-beijing.aliyuncs.com {
			header_up Host static.lutaai.co
			header_down Cache-Control "no-store, max-age=0"
			header_down -Age
			header_down -Expires
			transport http {
				tls_server_name luta-public.oss-cn-beijing.aliyuncs.com
			}
		}
		# Late fields are evaluated after reverse_proxy has written the
		# response. Content-Range plus bytes_written, not request Range,
		# define the delivered byte interval.
		log_append response_content_range {http.response.header.Content-Range}
	}

	# Never let malformed tokenized paths fall through to legacy OSS. Expiry is
	# checked by exact issuance-ledger reconciliation; delivery stays fail-open.
	@invalid_apk_delivery path /dl/*
	handle @invalid_apk_delivery {
		log_skip
		respond 404
	}

	@immutable_china_android path /releases/android/china/*
	handle @immutable_china_android {
		log_skip
		# Reach the OSS endpoint directly while keeping the bound custom Host.
		# Going through static.lutaai.co here would cross its Cloudflare cache,
		# where a pre-upload NoSuchKey response can otherwise outlive the upload.
		reverse_proxy https://luta-public.oss-cn-beijing.aliyuncs.com {
			header_up Host static.lutaai.co
			# download.lutaai.com is the user-facing handoff. Do not let browsers
			# retain an upstream error. The release script still stages the catalog
			# only after exact size + SHA public-readiness checks succeed.
			header_down Cache-Control "no-store, max-age=0"
			header_down -Age
			header_down -Expires
			transport http {
				tls_server_name luta-public.oss-cn-beijing.aliyuncs.com
			}
		}
	}

	handle {
		log_skip
		reverse_proxy https://luta-app.oss-cn-beijing.aliyuncs.com {
			header_up Host download.lutaai.com
			transport http {
				tls_server_name luta-app.oss-cn-beijing.aliyuncs.com
			}
		}
	}

	tls {$ACME_EMAIL}
}
